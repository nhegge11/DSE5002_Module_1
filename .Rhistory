#Assign values to variables
x <- 10
y <- 5
z <- 20
#Single boolean expression to check if x is less than z and greater than y
result_ex2 <- x < z & x > y
result_ex2
#Single boolean expression to check if x and y do not equal z
result_ex3 <- x != z & y != z
result_ex3
#Check if x + 2y equals z in a single boolean expression
result_ex4 <- (x + 2 * y) == z
result_ex4
#Check if x, y, or z are in the test_vector
test_vector <- c(1, 5, 11:22)
result_ex5 <- x %in% test_vector | y %in% test_vector | z %in% test_vector
result_ex5
#Find which values (x, y, or z) are contained in the test_vector and their indices
matches_x <- which(test_vector == x)
matches_y <- which(test_vector == y)
matches_z <- which(test_vector == z)
#Combine all matching indices into a single vector
all_matches <- c(matches_x, matches_y, matches_z)
all_matches
