library(forcats)
sales <- read.delim("sales_pipe.txt", stringsAsFactors = FALSE, sep = "|")
colnames(sales)[1] <- "Row.ID"
sales$Ship.Date <- ymd(sales$Ship.Date)
sales$Order.Date <- ymd(sales$Order.Date)
days_between <- as.numeric(difftime(max(sales$Order.Date), min(sales$Order.Date), units = "days"))
years_between <- days_between / 365
weeks_between <- days_between / 7
days_between
years_between
weeks_between
library(lubridate)
# Check and print unique date formats in Ship.Date and Order.Date
unique(sales$Ship.Date)
unique(sales$Order.Date)
# parse dates with error handling
sales$Ship.Date <- parse_date_time(sales$Ship.Date, orders = c("ymd", "dmy", "mdy"))
sales$Order.Date <- parse_date_time(sales$Order.Date, orders = c("ymd", "dmy", "mdy"))
# Check for failures
any(is.na(sales$Ship.Date))
any(is.na(sales$Order.Date))
# Calculate the time differences if dates are parsed correctly
if (!any(is.na(sales$Ship.Date)) && !any(is.na(sales$Order.Date))) {
days_between <- as.numeric(difftime(max(sales$Order.Date, na.rm = TRUE), min(sales$Order.Date, na.rm = TRUE), units = "days"))
years_between <- days_between / 365
weeks_between <- days_between / 7
print(days_between)
print(years_between)
print(weeks_between)
} else {
print("Error: Some dates could not be parsed.")
}
